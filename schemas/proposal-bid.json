{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/steven-tomlinson/agent-exchange-protocol-spec/main/schemas/proposal-bid.json",
  "title": "AEP Proposal Payload",
  "description": "Payload format for provider proposals and bids (proposal.bid, proposal.counter).",
  "type": "object",
  "required": [
    "type",
    "proposalId",
    "taskId",
    "revision",
    "providerId",
    "price",
    "estimatedCompletion",
    "confidence",
    "proposedDeliverables",
    "assumptions",
    "validUntil"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["proposal.bid", "proposal.counter", "proposal.clarification", "proposal.decline"]
    },
    "proposalId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "providerId": { "type": "string", "pattern": "^ae:[1-9A-HJ-NP-Za-km-z]+$" },
    "price": {
      "type": "object",
      "required": ["currency", "amount"],
      "properties": {
        "currency": { "type": "string", "enum": ["CREDIT", "XLM", "USDC", "LBX"] },
        "amount": { "type": "string", "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$" }
      }
    },
    "settlementRail": {
      "type": "string",
      "enum": ["demo-credit", "stellar-x402", "base-lockb0x"]
    },
    "estimatedCompletion": { "type": "string", "format": "date-time" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "proposedDeliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "mediaType"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "requestedInputs": { "type": "array", "items": { "type": "string" } },
    "validUntil": { "type": "string", "format": "date-time" },
    "supersedes": { "type": "string" }
  },
  "additionalProperties": false
}
