{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/steven-tomlinson/agent-exchange-protocol-spec/main/schemas/receipt-settlement.json",
  "title": "AEP Settlement Receipt",
  "description": "Portable settlement receipt payload.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "receipt.settlement"
    },
    "receiptId": {
      "type": "string",
      "minLength": 1
    },
    "agreementId": {
      "type": "string",
      "minLength": 1
    },
    "termsHash": {
      "type": "string",
      "minLength": 1
    },
    "requesterId": {
      "type": "string",
      "pattern": "^ae:[1-9A-HJ-NP-Za-km-z]+$"
    },
    "providerId": {
      "type": "string",
      "pattern": "^ae:[1-9A-HJ-NP-Za-km-z]+$"
    },
    "method": {
      "type": "string",
      "enum": [
        "demo-credit",
        "soroban",
        "base-lockb0x"
      ]
    },
    "amount": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "enum": [
            "CREDIT",
            "XLM",
            "USDC",
            "LBX"
          ]
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$"
        }
      },
      "required": [
        "currency",
        "amount"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "reserved",
        "released",
        "refunded",
        "failed"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "settledAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "settlementSignature": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "ES256K"
        },
        "publicKey": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "algorithm",
        "publicKey",
        "value"
      ],
      "additionalProperties": false
    },
    "transactionHash": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "type",
    "receiptId",
    "agreementId",
    "termsHash",
    "requesterId",
    "providerId",
    "method",
    "amount",
    "status",
    "reason",
    "settledAt",
    "settlementSignature"
  ],
  "additionalProperties": false
}
