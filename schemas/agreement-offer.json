{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/steven-tomlinson/agent-exchange-protocol-spec/main/schemas/agreement-offer.json",
  "title": "AEP Agreement Offer",
  "description": "Requester-signed agreement offer payload.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "agreement.offer"
    },
    "agreementId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "proposalId": {
      "type": "string",
      "minLength": 1
    },
    "requesterId": {
      "type": "string",
      "pattern": "^ae:[1-9A-HJ-NP-Za-km-z]+$"
    },
    "providerId": {
      "type": "string",
      "pattern": "^ae:[1-9A-HJ-NP-Za-km-z]+$"
    },
    "terms": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifactId": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "mediaType": {
                "type": "string",
                "minLength": 1
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "digest": {
                "type": "object",
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "const": "sha256"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "algorithm",
                  "value"
                ],
                "additionalProperties": false
              },
              "location": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "inline"
                      },
                      "data": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "data"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "https"
                      },
                      "uri": {
                        "type": "string",
                        "format": "uri"
                      }
                    },
                    "required": [
                      "type",
                      "uri"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "ipfs"
                      },
                      "cid": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "cid"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "logos-storage"
                      },
                      "cid": {
                        "type": "string",
                        "minLength": 16,
                        "maxLength": 256,
                        "pattern": "^[A-Za-z0-9]+$"
                      }
                    },
                    "required": [
                      "type",
                      "cid"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "lockb0x"
                      },
                      "uri": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "uri"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "encryption": {
                "type": "object",
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "const": "xchacha20-poly1305"
                  },
                  "keyEnvelope": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "algorithm",
                  "keyEnvelope"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "artifactId",
              "name",
              "mediaType",
              "byteLength",
              "digest",
              "location"
            ],
            "additionalProperties": false
          }
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "mediaType": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "description",
              "mediaType"
            ],
            "additionalProperties": false
          }
        },
        "price": {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "enum": [
                "CREDIT",
                "XLM",
                "USDC",
                "LBX"
              ]
            },
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$"
            }
          },
          "required": [
            "currency",
            "amount"
          ],
          "additionalProperties": false
        },
        "deadline": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "acceptance": {},
        "settlement": {}
      },
      "required": [
        "objective",
        "inputs",
        "deliverables",
        "price",
        "deadline",
        "acceptance",
        "settlement"
      ],
      "additionalProperties": false
    },
    "termsHash": {
      "type": "string",
      "minLength": 1
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "requesterSignature": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "ES256K"
        },
        "publicKey": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "algorithm",
        "publicKey",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "agreementId",
    "taskId",
    "proposalId",
    "requesterId",
    "providerId",
    "terms",
    "termsHash",
    "expiresAt",
    "requesterSignature"
  ],
  "additionalProperties": false
}
