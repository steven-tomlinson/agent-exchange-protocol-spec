{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/steven-tomlinson/agent-exchange-protocol-spec/main/schemas/agent-card.json",
  "title": "AEP Agent Card",
  "description": "Provider capability advertisement payload.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "agent.card"
    },
    "agentId": {
      "type": "string",
      "pattern": "^ae:[1-9A-HJ-NP-Za-km-z]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "network": {
      "type": "string",
      "enum": [
        "stellar:testnet",
        "stellar:pubnet",
        "eip155:84532",
        "eip155:8453"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputSchema": {},
          "outputSchema": {}
        },
        "required": [
          "id",
          "name",
          "description",
          "tags"
        ],
        "additionalProperties": false
      }
    },
    "pricing": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "enum": [
            "CREDIT",
            "XLM",
            "USDC",
            "LBX"
          ]
        },
        "model": {
          "type": "string",
          "enum": [
            "fixed",
            "per-token",
            "per-minute",
            "negotiated"
          ]
        },
        "minimum": {
          "type": "string"
        }
      },
      "required": [
        "currency",
        "model"
      ],
      "additionalProperties": false
    },
    "supportedSettlementRails": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "demo-credit",
          "stellar-x402",
          "base-lockb0x"
        ]
      }
    },
    "payouts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rail": {
            "type": "string",
            "enum": [
              "demo-credit",
              "stellar-x402",
              "base-lockb0x"
            ]
          },
          "payTo": {
            "type": "string",
            "minLength": 1
          },
          "resource": {
            "type": "string",
            "format": "uri"
          },
          "lockb0x": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          }
        },
        "required": [
          "rail",
          "payTo"
        ],
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "maxConcurrentTasks": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "supportedMediaTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiresHumanApproval": {
          "type": "boolean"
        }
      },
      "required": [
        "maxConcurrentTasks",
        "supportedMediaTypes"
      ],
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "available",
            "busy",
            "offline"
          ]
        },
        "validUntil": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        }
      },
      "required": [
        "status",
        "validUntil"
      ],
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "properties": {
        "versions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "const": "0.2"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "versions",
        "extensions"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "publicKey": {
          "type": "string",
          "minLength": 1
        },
        "signingAlgorithm": {
          "type": "string",
          "const": "ES256K"
        }
      },
      "required": [
        "publicKey",
        "signingAlgorithm"
      ],
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "properties": {
        "iconUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "iconUrl"
      ],
      "additionalProperties": false
    },
    "advertisement": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "live",
            "preview"
          ]
        },
        "badges": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "STELLAR",
              "BASE",
              "PREVIEW"
            ]
          }
        }
      },
      "required": [
        "mode",
        "badges"
      ],
      "additionalProperties": false
    },
    "certifications": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "pakana.certification.reference.v1"
          },
          "certificateId": {
            "type": "string",
            "pattern": "^urn:pakana:(starter-pack|agent-control):[a-f0-9]{64}$"
          },
          "subjectId": {
            "type": "string",
            "pattern": "^ae:[1-9A-HJ-NP-Za-km-z]+$"
          },
          "credentialType": {
            "type": "string",
            "enum": [
              "pakana.starter-pack.credential.v1",
              "pakana.agent-control.credential.v1"
            ]
          },
          "issuerVerificationMethod": {
            "type": "string",
            "pattern": "^(G[A-Z2-7]{55}|0x[0-9a-fA-F]{40})$"
          },
          "digest": {
            "type": "object",
            "properties": {
              "algorithm": {
                "type": "string",
                "const": "sha256-pakana-json-v1"
              },
              "value": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "algorithm",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "certificateId",
          "subjectId",
          "credentialType",
          "issuerVerificationMethod",
          "digest"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "type",
    "agentId",
    "name",
    "description",
    "capabilities",
    "pricing",
    "constraints",
    "availability",
    "protocol",
    "identity"
  ],
  "additionalProperties": false
}
