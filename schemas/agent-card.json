{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aep-spec/agent-exchange-protocol-spec/main/schemas/agent-card.json",
  "title": "AEP Agent Card Payload",
  "description": "Payload format for agent capability advertisement (agent.card).",
  "type": "object",
  "required": [
    "type",
    "agentId",
    "name",
    "description",
    "capabilities",
    "pricing",
    "constraints",
    "availability",
    "protocol",
    "identity"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "agent.card"
    },
    "agentId": {
      "type": "string",
      "pattern": "^ae:[1-9A-HJ-NP-Za-km-z]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "network": {
      "type": "string",
      "enum": [
        "stellar:testnet",
        "stellar:pubnet",
        "eip155:84532",
        "eip155:8453"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "tags"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "inputSchema": {},
          "outputSchema": {}
        }
      }
    },
    "pricing": {
      "type": "object",
      "required": ["currency", "model"],
      "properties": {
        "currency": {
          "type": "string",
          "enum": ["CREDIT", "XLM", "USDC", "LBX"]
        },
        "model": {
          "type": "string",
          "enum": ["fixed", "per-token", "per-minute", "negotiated"]
        },
        "minimum": {
          "type": "string"
        }
      }
    },
    "supportedSettlementRails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["demo-credit", "stellar-x402", "base-lockb0x"]
      }
    },
    "payouts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rail", "payTo"],
        "properties": {
          "rail": {
            "type": "string",
            "enum": ["demo-credit", "stellar-x402", "base-lockb0x"]
          },
          "payTo": { "type": "string", "minLength": 1 },
          "resource": { "type": "string", "format": "uri" },
          "lockb0x": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
        }
      }
    },
    "constraints": {
      "type": "object",
      "required": ["maxConcurrentTasks", "supportedMediaTypes"],
      "properties": {
        "maxConcurrentTasks": { "type": "integer", "minimum": 1 },
        "supportedMediaTypes": { "type": "array", "items": { "type": "string" } },
        "requiresHumanApproval": { "type": "boolean" }
      }
    },
    "availability": {
      "type": "object",
      "required": ["status", "validUntil"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["available", "busy", "offline"]
        },
        "validUntil": { "type": "string", "format": "date-time" }
      }
    },
    "protocol": {
      "type": "object",
      "required": ["versions", "extensions"],
      "properties": {
        "versions": {
          "type": "array",
          "items": { "type": "string", "const": "0.2" },
          "minItems": 1
        },
        "extensions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "identity": {
      "type": "object",
      "required": ["publicKey", "signingAlgorithm"],
      "properties": {
        "publicKey": { "type": "string", "minLength": 1 },
        "signingAlgorithm": { "type": "string", "const": "ES256K" }
      }
    }
  },
  "additionalProperties": false
}
