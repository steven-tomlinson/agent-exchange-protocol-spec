{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/steven-tomlinson/agent-exchange-protocol-spec/main/schemas/receipt-evaluation.json",
  "title": "AEP Evaluation Receipt",
  "description": "Requester evaluation receipt payload.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "receipt.evaluation"
    },
    "receiptId": {
      "type": "string",
      "minLength": 1
    },
    "deliveryReceiptId": {
      "type": "string",
      "minLength": 1
    },
    "evaluatorId": {
      "type": "string",
      "pattern": "^ae:[1-9A-HJ-NP-Za-km-z]+$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "passed"
        ],
        "additionalProperties": false
      }
    },
    "scores": {
      "type": "object",
      "properties": {
        "quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "timeliness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "compliance": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "quality",
        "timeliness",
        "compliance"
      ],
      "additionalProperties": false
    },
    "overallScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "evaluationMethod": {
      "type": "string",
      "enum": [
        "deterministic",
        "human",
        "llm",
        "hybrid"
      ]
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "evaluatorSignature": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "ES256K"
        },
        "publicKey": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "algorithm",
        "publicKey",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "receiptId",
    "deliveryReceiptId",
    "evaluatorId",
    "checks",
    "scores",
    "overallScore",
    "evaluationMethod",
    "evaluatorSignature"
  ],
  "additionalProperties": false
}
