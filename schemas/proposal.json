{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/steven-tomlinson/agent-exchange-protocol-spec/main/schemas/proposal.json",
  "title": "AEP Proposal",
  "description": "Bid, counteroffer, clarification, or decline proposal payload.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "proposal.bid",
        "proposal.counter",
        "proposal.clarification",
        "proposal.decline"
      ]
    },
    "proposalId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "providerId": {
      "type": "string",
      "pattern": "^ae:[1-9A-HJ-NP-Za-km-z]+$"
    },
    "price": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "enum": [
            "CREDIT",
            "XLM",
            "USDC",
            "LBX"
          ]
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$"
        }
      },
      "required": [
        "currency",
        "amount"
      ],
      "additionalProperties": false
    },
    "settlementRail": {
      "type": "string",
      "enum": [
        "demo-credit",
        "stellar-x402",
        "base-lockb0x"
      ]
    },
    "estimatedCompletion": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "proposedDeliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description",
          "mediaType"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requestedInputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validUntil": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "supersedes": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "proposalId",
    "taskId",
    "revision",
    "providerId",
    "price",
    "estimatedCompletion",
    "confidence",
    "proposedDeliverables",
    "assumptions",
    "validUntil"
  ],
  "additionalProperties": false
}
